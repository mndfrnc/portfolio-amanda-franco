---
import { Image } from "astro:assets";
import pastinha from "../assets/elementos-mao/pastinha-case-icon.png";
import { copy } from "../data/copy.js";
import { cases, camposSintese } from "../data/cases.js";
---

<section id="cases" class="cases" aria-label="Cases selecionados">
  <div class="cases__inner">
    <h2 class="kicker">
      {copy.casesKicker}
      <Image src={pastinha} alt="" role="presentation" width={108} height={81} class="cases__kicker-icone" />
    </h2>
    <p class="cases__intro">{copy.casesIntro}</p>

    <ul class="cases__lista">
      {cases.map((c) => (
        <li class="case-card">
          <div class="case-card__topo">
            <Image src={pastinha} alt="" role="presentation" width={108} height={81} class="case-card__icone" />
            <div class="case-card__titulo-bloco">
              <h3>{c.titulo}</h3>
              <p class="case-card__tag">{c.tag}</p>
            </div>
            {c.badge && <p class="case-card__badge">{c.badge}</p>}
          </div>

          <dl class="case-card__grid">
            {camposSintese.map((campo, i) => (
              <div class="case-card__campo">
                <dt>{campo}</dt>
                <dd>{c.sintese[i]}</dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cases {
    background: var(--offwhite);
  }

  .cases__inner {
    max-width: var(--largura-max);
    margin-inline: auto;
    padding-inline: var(--margem);
    padding-block: var(--secao-gap);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--tamanho-legenda);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul-profundo);
    margin-bottom: 1rem;
  }

  .kicker::before {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--magenta);
    flex-shrink: 0;
  }

  :global(.cases__kicker-icone) {
    height: 18px;
    width: auto;
    margin-left: 0.375rem;
    opacity: 0.5;
    flex-shrink: 0;
  }

  .cases__intro {
    font-size: 0.9375rem;
    color: var(--texto-suporte);
    max-width: 40rem;
    margin-bottom: clamp(2rem, 5vw, 2.5rem);
  }

  .cases__lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .case-card {
    background: var(--branco);
    border: 1.5px solid var(--hairline);
    border-radius: 14px;
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }

  .case-card__topo {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  :global(.case-card__icone) {
    width: 40px;
    height: auto;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .case-card__titulo-bloco {
    flex: 1 1 14rem;
  }

  .case-card__titulo-bloco h3 {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--azul-profundo);
    line-height: 1.2;
  }

  .case-card__tag {
    font-size: 0.8125rem;
    color: var(--texto-suporte);
    margin-top: 0.375rem;
  }

  .case-card__badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.625rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--magenta);
    line-height: 1;
    border: 1.5px solid var(--magenta);
    border-radius: 99px;
    padding: 0.3125rem 0.875rem;
  }

  .case-card__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem 2rem;
  }

  .case-card__campo dt {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--texto-suporte);
    margin-bottom: 0.375rem;
  }

  .case-card__campo dd {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--texto-corpo);
  }

  @media (min-width: 640px) {
    .case-card__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
