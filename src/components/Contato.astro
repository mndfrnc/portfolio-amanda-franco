---
import { copy } from "../data/copy.js";
---

<section id="contato" class="contato" aria-label="Contato">
  <div class="contato__atmosfera" aria-hidden="true"></div>

  <div class="contato__inner">
    <p class="kicker">{copy.contatoKicker}</p>
    <h2>{copy.contatoH2}</h2>

    <ul class="contato__lista">
      <li>
        <a href={copy.whatsappHref} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path></svg>
          {copy.whatsapp}
        </a>
      </li>
      <li>
        <a href={`mailto:${copy.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          {copy.email}
        </a>
      </li>
      <li>
        <a href={copy.linkedinHref} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          {copy.linkedin}
        </a>
      </li>
    </ul>

    <a class="botao botao--cheio" href="https://wa.me/message/DZPTC4OK4T2SN1" target="_blank" rel="noopener noreferrer">{copy.contatoCta}</a>

    <footer class="contato__rodape">
      <div class="contato__marca">
        <img
          src="/identidade/amanda-wordmark-atual.svg"
          alt="amanda*"
          class="contato__identificacao"
          width="432"
          height="93"
        />
      </div>
      <p class="contato__copyright">© 2026 Amanda Franco</p>
    </footer>
  </div>
</section>

<style>
  .contato {
    position: relative;
    background: var(--offwhite);
    border-top: 3px solid var(--azul-profundo);
    overflow: hidden;
  }

  .contato__atmosfera {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(160deg, var(--azul-profundo) 0%, #0e1c30 100%);
    opacity: 0.05;
  }

  .contato__inner {
    position: relative;
    z-index: 1;
    max-width: var(--largura-max);
    margin-inline: auto;
    padding-inline: var(--margem);
    padding-top: var(--secao-gap);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--tamanho-legenda);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul-profundo);
    margin-bottom: 1.25rem;
  }

  .kicker::before {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--magenta);
    flex-shrink: 0;
  }

  .contato__inner h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--tamanho-h2);
    line-height: 1.2;
    color: var(--azul-profundo);
    max-width: 44rem;
    text-wrap: balance;
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  .contato__lista {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 2.5rem);
  }

  .contato__lista a {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-sans);
    font-size: var(--tamanho-corpo);
    font-weight: 500;
    color: var(--azul-profundo);
    text-decoration: none;
    min-height: 44px;
  }

  .contato__lista a:hover {
    color: var(--magenta);
  }

  .contato__lista svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .contato__rodape {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  .contato__marca {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .contato__simbolo {
    height: 32px;
    width: auto;
  }

  .contato__identificacao {
    height: 15px;
    width: auto;
    opacity: 0.65;
  }

  .contato__copyright {
    font-size: 0.75rem;
    color: var(--texto-suporte);
  }
</style>
