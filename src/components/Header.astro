---
import { navItems } from "../data/copy.js";
---

<header class="header">
  <div class="header__inner">
    <a href="#inicio" class="header__wordmark" aria-label="Amanda Franco — início">
      <img src="/identidade/wordmark-amanda.svg" alt="amanda" width="150" height="36" />
    </a>

    <nav class="header__nav" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--offwhite);
    border-bottom: 1px solid var(--hairline);
  }

  .header__inner {
    max-width: var(--largura-max);
    margin-inline: auto;
    padding-inline: var(--margem);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header__wordmark {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
  }

  .header__wordmark img {
    height: 22px;
    width: auto;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: calc(100% - 120px);
    scrollbar-width: none;
  }

  .header__nav::-webkit-scrollbar {
    display: none;
  }

  .header__nav a {
    font-family: var(--font-sans);
    font-size: var(--tamanho-legenda);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--azul-profundo);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header__nav a:hover {
    color: var(--magenta);
  }

  @media (min-width: 640px) {
    .header__nav {
      gap: 0.875rem;
    }
  }

  @media (min-width: 860px) {
    .header__nav {
      gap: clamp(1rem, 2vw, 2rem);
    }
  }
</style>
