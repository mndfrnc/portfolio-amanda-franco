---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getBlogPosts } from "../../data/storyblok.js";

const posts = await getBlogPosts();
---

<Layout
  title="Blog — Amanda Franco"
  description="Relatos sobre trabalho, recomeços, processos e tudo o que acontece antes de uma entrega parecer pronta."
>
  <Header />
  <main>
    <section id="blog" class="blog-intro" aria-label="Blog">
      <div class="blog-intro__inner">
        <p class="kicker">Blog</p>
        <h1 class="blog-intro__titulo">O que o LinkedIn não mostra</h1>
        <p class="blog-intro__texto">
          Relatos sobre trabalho, recomeços, processos e tudo o que acontece antes de uma entrega
          parecer pronta.
        </p>
      </div>
    </section>

    <section class="blog-lista" aria-label="Artigos publicados">
      <div class="blog-lista__inner">
        {posts.length > 0 ? (
          <ul class="blog-lista__grid">
            {posts.map((post) => (
              <BlogCard post={post} />
            ))}
          </ul>
        ) : (
          <div class="blog-vazio">
            <p class="blog-vazio__titulo">Em breve, novos relatos por aqui.</p>
            <p class="blog-vazio__texto">Nenhum artigo publicado no momento — volte em breve.</p>
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .blog-intro {
    background: var(--offwhite);
    border-bottom: 1px solid var(--hairline);
  }

  .blog-intro__inner {
    max-width: var(--largura-max);
    margin-inline: auto;
    padding-inline: var(--margem);
    padding-block: clamp(2rem, 5vw, 3.75rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--tamanho-legenda);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul-profundo);
    margin-bottom: 1.25rem;
  }

  .kicker::before {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--magenta);
    flex-shrink: 0;
  }

  .blog-intro__titulo {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--tamanho-h1);
    line-height: 1.06;
    color: var(--azul-profundo);
    text-wrap: balance;
    margin-bottom: 1.125rem;
    max-width: 34rem;
  }

  .blog-intro__texto {
    font-size: var(--tamanho-corpo);
    line-height: 1.6;
    color: var(--texto-suporte);
    max-width: 38rem;
  }

  .blog-lista {
    background: var(--branco);
  }

  .blog-lista__inner {
    max-width: var(--largura-max);
    margin-inline: auto;
    padding-inline: var(--margem);
    padding-block: var(--secao-gap);
  }

  .blog-lista__grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 640px) {
    .blog-lista__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .blog-lista__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog-vazio {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
    padding: clamp(2.5rem, 6vw, 4rem);
    background: var(--offwhite);
    border: 1.5px dashed var(--hairline);
    border-radius: 14px;
  }

  .blog-vazio__titulo {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--azul-profundo);
  }

  .blog-vazio__texto {
    font-size: 0.9375rem;
    color: var(--texto-suporte);
  }
</style>
