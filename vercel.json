{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/FBO",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/FBO/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
